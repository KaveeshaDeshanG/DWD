@{
    var adminName = User.Identity?.Name ?? string.Empty;
    var nameParts = adminName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials = string.Concat(nameParts.Select(p => p[0])).ToUpperInvariant();
    if (initials.Length > 2)
    {
        initials = initials[..2];
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin - Community Sports Facilities Booking System</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CommunitySportsBooking.Web.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100 admin-body">
    <a href="#admin-main-content" class="skip-link">Skip to main content</a>

    <header class="admin-topbar border-bottom bg-white sticky-top">
        <div class="d-flex align-items-center justify-content-between px-3 py-2">
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-outline-secondary d-lg-none" type="button"
                        data-bs-toggle="offcanvas" data-bs-target="#adminSidebar" aria-controls="adminSidebar">
                    <i class="bi bi-list" aria-hidden="true"></i>
                    <span class="visually-hidden">Toggle admin menu</span>
                </button>
                <a class="navbar-brand fw-semibold d-flex align-items-center gap-2 mb-0" href="/">
                    <i class="bi bi-trophy-fill text-primary" aria-hidden="true"></i>
                    <span class="d-none d-sm-inline">Community Sports Booking</span>
                </a>
                <span class="badge text-bg-dark">Admin</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <a href="/" class="btn btn-sm btn-outline-secondary d-none d-sm-inline-flex">
                    <i class="bi bi-box-arrow-up-right me-1" aria-hidden="true"></i>View site
                </a>
                <div class="dropdown">
                    <button class="btn btn-link text-dark text-decoration-none dropdown-toggle d-flex align-items-center gap-2 nav-link-button"
                            type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="nav-avatar" aria-hidden="true">@initials</span>
                        <span class="d-none d-md-inline">@adminName</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                        <li><a class="dropdown-item" href="/"><i class="bi bi-arrow-left me-2" aria-hidden="true"></i>Return to site</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>Logout</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </header>

    <div class="d-flex flex-grow-1 admin-shell">
        @await Html.PartialAsync("_AdminSidebarPartial")

        <main id="admin-main-content" role="main" class="flex-grow-1 p-3 p-lg-4 min-w-0">
            @await Html.PartialAsync("_AlertPartial")
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

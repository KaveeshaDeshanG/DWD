@model FacilityIndexViewModel
@{
    ViewData["Title"] = "Facilities";
}

<div class="page-section">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
        <div>
            <h2 class="mb-1"><i class="bi bi-building me-2" aria-hidden="true"></i>Facilities</h2>
            <p class="text-muted mb-0">@Model.Facilities.Count facilit@(Model.Facilities.Count == 1 ? "y" : "ies") matching the current filters.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Add Facility</a>
    </div>
</div>

<div class="form-card mb-3">
    <form asp-action="Index" method="get" class="row g-2 align-items-end">
        <div class="col-sm-6 col-lg-5">
            <label for="search" class="form-label">Search</label>
            <input type="text" id="search" name="search" class="form-control" value="@Model.Search" placeholder="Name, type, location, or city" />
        </div>
        <div class="col-sm-4 col-lg-3">
            <label for="status" class="form-label">Status</label>
            <select id="status" name="status" class="form-select">
                <option value="" selected="@(string.IsNullOrEmpty(Model.Status))">All</option>
                <option value="active" selected="@(Model.Status == "active")">Active only</option>
                <option value="inactive" selected="@(Model.Status == "inactive")">Inactive only</option>
            </select>
        </div>
        <div class="col-auto d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-search me-1" aria-hidden="true"></i>Search</button>
            <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise me-1" aria-hidden="true"></i>Clear</a>
        </div>
    </form>
</div>

@if (!Model.Facilities.Any())
{
    <div class="empty-state">
        <i class="bi bi-building fs-2 text-muted d-block mb-2" aria-hidden="true"></i>
        <p class="mb-0">No facilities matched your filters.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle bg-white">
            <thead>
                <tr>
                    <th scope="col">Facility</th>
                    <th scope="col">Type</th>
                    <th scope="col">City</th>
                    <th scope="col">Sports</th>
                    <th scope="col">Bookings</th>
                    <th scope="col">Status</th>
                    <th scope="col"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var facility in Model.Facilities)
                {
                    <tr>
                        <td>@facility.FacilityName</td>
                        <td>@facility.FacilityType</td>
                        <td>@facility.City</td>
                        <td>@facility.SportCount</td>
                        <td>@facility.BookingCount</td>
                        <td>
                            @if (facility.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary-emphasis border">Inactive</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@facility.FacilityId" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-eye me-1" aria-hidden="true"></i>View
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

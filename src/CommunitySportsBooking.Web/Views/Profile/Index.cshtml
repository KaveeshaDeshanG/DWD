@model ProfileViewModel
@{
    ViewData["Title"] = "My Profile";
    var initials = $"{(Model.FirstName.Length > 0 ? Model.FirstName[0] : ' ')}{(Model.LastName.Length > 0 ? Model.LastName[0] : ' ')}".Trim().ToUpperInvariant();
}

<div class="page-section">
    <div class="d-flex align-items-center gap-3 mb-4">
        <div class="profile-avatar" aria-hidden="true">@initials</div>
        <div>
            <h1 class="h3 mb-0">@Model.FirstName @Model.LastName</h1>
            <p class="text-muted mb-0 small"><i class="bi bi-calendar3 me-1" aria-hidden="true"></i>Member since @Model.RegisteredDate.ToString("MMMM yyyy")</p>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-lg-7">
            <div class="form-section-title"><i class="bi bi-person-badge" aria-hidden="true"></i> Personal Information</div>
            <div class="form-card">
                <form asp-controller="Profile" asp-action="Edit" method="post" novalidate>
                    <div asp-validation-summary="All"></div>

                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope" aria-hidden="true"></i></span>
                            <input type="text" class="form-control" value="@Model.Email" disabled readonly />
                        </div>
                        <div class="form-text">Email cannot be changed.</div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label"></label>
                            <input asp-for="FirstName" class="form-control" />
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LastName" class="form-label"></label>
                            <input asp-for="LastName" class="form-control" />
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label"></label>
                            <input asp-for="Phone" class="form-control" />
                            <span asp-validation-for="Phone" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="City" class="form-label"></label>
                            <input asp-for="City" class="form-control" />
                            <span asp-validation-for="City" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="AddressLine" class="form-label"></label>
                            <input asp-for="AddressLine" class="form-control" />
                            <span asp-validation-for="AddressLine" class="text-danger"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary mt-3"><i class="bi bi-check2 me-1" aria-hidden="true"></i>Save Changes</button>
                </form>
            </div>
        </div>
    </div>

    <div class="row" id="sports-preferences">
        <div class="col-lg-7">
            <div class="form-section-title"><i class="bi bi-trophy" aria-hidden="true"></i> Preferred Sports</div>
            <div class="form-card">
                <form asp-controller="Profile" asp-action="Sports" method="post">
                    <div class="sport-chip-group mb-3">
                        @foreach (var sport in Model.AvailableSports)
                        {
                            var icon = ImageResolver.GetSportIconPath(sport.SportName);
                            <input type="checkbox" class="btn-check" name="SelectedSportIds" value="@sport.SportId" id="pref-sport-@sport.SportId" checked="@sport.IsSelected" autocomplete="off" />
                            <label class="btn btn-outline-secondary sport-chip" for="pref-sport-@sport.SportId">
                                @if (icon is not null)
                                {
                                    <img src="@icon" alt="" />
                                }
                                @sport.SportName
                            </label>
                        }
                    </div>
                    <button type="submit" class="btn btn-secondary"><i class="bi bi-check2 me-1" aria-hidden="true"></i>Update Preferences</button>
                </form>
            </div>
        </div>
    </div>
</div>

@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<div class="page-section">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="text-center mb-4">
                <h1 class="h3 mb-1">Create your account</h1>
                <p class="text-muted mb-0">Register to search by date and time, and start booking facilities.</p>
            </div>

            <div class="form-card">
                <form asp-controller="Account" asp-action="Register" method="post" novalidate>
                    <div asp-validation-summary="All"></div>

                    <div class="form-section">
                        <div class="form-section-title"><i class="bi bi-person-badge" aria-hidden="true"></i> Account Details</div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="FirstName" class="form-label"></label>
                                <input asp-for="FirstName" class="form-control" />
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="LastName" class="form-label"></label>
                                <input asp-for="LastName" class="form-control" />
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Email" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-envelope" aria-hidden="true"></i></span>
                                    <input asp-for="Email" class="form-control" autocomplete="username" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Password" class="form-label"></label>
                                <div class="input-group password-input-group">
                                    <span class="input-group-text"><i class="bi bi-lock" aria-hidden="true"></i></span>
                                    <input asp-for="Password" class="form-control" id="registerPassword" autocomplete="new-password" data-password-requirements-target="registerPasswordRules" />
                                    <button class="btn btn-outline-secondary" type="button" data-password-toggle="registerPassword" aria-label="Show password">
                                        <i class="bi bi-eye" aria-hidden="true"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="Password" class="text-danger"></span>
                                <ul class="password-requirements" id="registerPasswordRules">
                                    <li data-rule="length"><i class="bi" aria-hidden="true"></i> At least 8 characters</li>
                                    <li data-rule="letter"><i class="bi" aria-hidden="true"></i> At least one letter</li>
                                    <li data-rule="digit"><i class="bi" aria-hidden="true"></i> At least one digit</li>
                                </ul>
                            </div>
                            <div class="col-12">
                                <label asp-for="ConfirmPassword" class="form-label"></label>
                                <div class="input-group password-input-group">
                                    <span class="input-group-text"><i class="bi bi-lock" aria-hidden="true"></i></span>
                                    <input asp-for="ConfirmPassword" class="form-control" id="registerConfirmPassword" autocomplete="new-password" />
                                    <button class="btn btn-outline-secondary" type="button" data-password-toggle="registerConfirmPassword" aria-label="Show password">
                                        <i class="bi bi-eye" aria-hidden="true"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-section">
                        <div class="form-section-title"><i class="bi bi-geo-alt" aria-hidden="true"></i> Contact Details</div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label"></label>
                                <input asp-for="Phone" class="form-control" />
                                <span asp-validation-for="Phone" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="City" class="form-label"></label>
                                <input asp-for="City" class="form-control" />
                                <span asp-validation-for="City" class="text-danger"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="AddressLine" class="form-label"></label>
                                <input asp-for="AddressLine" class="form-control" />
                                <span asp-validation-for="AddressLine" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-section">
                        <div class="form-section-title"><i class="bi bi-trophy" aria-hidden="true"></i> Preferred Sports <span class="text-muted text-lowercase fw-normal">(optional)</span></div>

                        <div class="sport-chip-group">
                            @foreach (var sport in Model.AvailableSports)
                            {
                                var icon = ImageResolver.GetSportIconPath(sport.SportName);
                                <input type="checkbox" class="btn-check" name="SelectedSportIds" value="@sport.SportId" id="sport-@sport.SportId" checked="@sport.IsSelected" autocomplete="off" />
                                <label class="btn btn-outline-secondary sport-chip" for="sport-@sport.SportId">
                                    @if (icon is not null)
                                    {
                                        <img src="@icon" alt="" />
                                    }
                                    @sport.SportName
                                </label>
                            }
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 mt-4">
                        <i class="bi bi-person-plus me-1" aria-hidden="true"></i> Create Account
                    </button>

                    <p class="text-center text-muted mt-3 mb-0">
                        Already have an account? <a href="/Account/Login">Sign in</a>
                    </p>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}

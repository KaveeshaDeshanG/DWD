@model LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="auth-shell">
    <div class="auth-form-panel">
        <div class="auth-form-inner">
            <h1 class="h3 mb-1">Welcome back</h1>
            <p class="text-muted mb-4">Sign in to search by date and time, and manage your bookings.</p>

            <form asp-controller="Account" asp-action="Login" method="post" novalidate>
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="All"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-envelope" aria-hidden="true"></i></span>
                        <input asp-for="Email" class="form-control" autocomplete="username" autofocus />
                    </div>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-2">
                    <label asp-for="Password" class="form-label"></label>
                    <div class="input-group password-input-group">
                        <span class="input-group-text"><i class="bi bi-lock" aria-hidden="true"></i></span>
                        <input asp-for="Password" class="form-control" id="loginPassword" autocomplete="current-password" />
                        <button class="btn btn-outline-secondary" type="button" data-password-toggle="loginPassword" aria-label="Show password">
                            <i class="bi bi-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label"></label>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2">
                    <i class="bi bi-box-arrow-in-right me-1" aria-hidden="true"></i> Sign In
                </button>

                <p class="text-center text-muted mt-4 mb-0">
                    Don't have an account? <a href="/Account/Register">Register</a>
                </p>
            </form>
        </div>
    </div>
    <div class="auth-visual" aria-hidden="true">
        <div class="auth-visual-icon"><i class="bi bi-trophy" aria-hidden="true"></i></div>
        <h2 class="h3 fw-bold">Community Sports Facilities Booking</h2>
        <p class="mb-0" style="color:#e0e7ff;">Find, explore and book local sports facilities in a few clicks.</p>
        <ul>
            <li><i class="bi bi-calendar-check" aria-hidden="true"></i> Real-time facility availability</li>
            <li><i class="bi bi-lightning-charge" aria-hidden="true"></i> Instant booking confirmation</li>
            <li><i class="bi bi-shield-check" aria-hidden="true"></i> Your bookings, private to your account</li>
        </ul>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}

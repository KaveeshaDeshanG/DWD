@model ReviewSearchViewModel
@{
    ViewData["Title"] = "Facility Reviews";
}

<div class="page-section">
    <h1 class="h3 mb-1"><i class="bi bi-star" aria-hidden="true"></i> Facility Reviews</h1>
    <p class="text-muted">Read what other members think of our facilities. No account needed.</p>

    <div class="form-card mb-3">
        <form asp-controller="Review" asp-action="Search" method="post" novalidate>
            <div asp-validation-summary="All"></div>
            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label asp-for="FacilityName" class="form-label"></label>
                    <input asp-for="FacilityName" class="form-control" placeholder="e.g. Riverside Tennis Courts" />
                </div>
                <div class="col-md-4">
                    <label asp-for="FacilityType" class="form-label"></label>
                    <input asp-for="FacilityType" class="form-control" placeholder="e.g. Tennis Court" />
                </div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-search me-1" aria-hidden="true"></i>Search</button>
                <a href="/Review/Search" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise me-1" aria-hidden="true"></i>Clear</a>
            </div>
        </form>
    </div>

    @if (Model.HasSearched)
    {
        @if (!Model.Results.Any())
        {
            <div class="empty-state">
                <i class="bi bi-star fs-2 text-muted d-block mb-2" aria-hidden="true"></i>
                <p class="mb-0">No reviews matched your search.</p>
            </div>
        }
        else
        {
            <p class="text-muted">@Model.Results.Count review@(Model.Results.Count == 1 ? "" : "s") found.</p>
            @foreach (var review in Model.Results)
            {
                <div class="review-card">
                    <div class="review-meta">
                        <div>
                            <span class="review-facility">@review.FacilityName</span>
                            <span class="text-muted small"> &middot; @review.FacilityType</span>
                        </div>
                        <span class="review-date">@review.ReviewDate.ToString("dd MMM yyyy")</span>
                    </div>
                    @await Html.PartialAsync("_StarRatingPartial", review.Rating)
                    <p class="mb-1 mt-2">@review.Comment</p>
                    <p class="text-muted small mb-0">— @review.ReviewerDisplayName</p>
                    <a href="/Facility/@review.FacilityId" class="small">View facility &rarr;</a>
                </div>
            }
        }
    }
    else
    {
        <div class="empty-state">
            <p class="mb-0">Search by facility name or type, or leave both blank to see all reviews.</p>
        </div>
    }
</div>

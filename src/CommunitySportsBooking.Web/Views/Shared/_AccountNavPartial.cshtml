@* Navigation branches on authentication state (SPEC-002 authorization matrix). *@
@if (User.Identity?.IsAuthenticated == true)
{
    <li class="nav-item">
        <a class="nav-link text-dark" href="/Booking/MyBookings">My Bookings</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-dark" href="/Profile">Profile</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-dark" href="/Profile#sports-preferences">Sports Preferences</a>
    </li>
    <li class="nav-item d-flex align-items-center">
        <span class="nav-link text-muted pe-2">Hello, @User.Identity!.Name</span>
    </li>
    <li class="nav-item">
        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
            <button type="submit" class="btn btn-outline-secondary btn-sm">Logout</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-dark" href="/Account/Login">Login</a>
    </li>
    <li class="nav-item">
        <a class="btn btn-primary btn-sm" href="/Account/Register">Register</a>
    </li>
}

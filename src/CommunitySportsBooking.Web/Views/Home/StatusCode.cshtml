@model int
@{
    var (icon, title, message) = Model switch
    {
        404 => ("bi-signpost-2", "Page not found", "The page you're looking for doesn't exist or may have been moved."),
        403 => ("bi-shield-lock", "Access denied", "You don't have permission to view that page."),
        _ => ("bi-exclamation-triangle", "Something went wrong", "We couldn't complete that request.")
    };
    ViewData["Title"] = title;
}

<div class="empty-state my-5">
    <i class="bi @icon fs-1 text-muted d-block mb-3" aria-hidden="true"></i>
    <h1 class="h2">@title</h1>
    <p>@message</p>
    <div class="d-flex justify-content-center gap-2 flex-wrap">
        <a href="/" class="btn btn-primary"><i class="bi bi-house-door me-1" aria-hidden="true"></i>Return home</a>
        <a href="/Facility" class="btn btn-outline-primary"><i class="bi bi-search me-1" aria-hidden="true"></i>Browse Facilities</a>
    </div>
</div>

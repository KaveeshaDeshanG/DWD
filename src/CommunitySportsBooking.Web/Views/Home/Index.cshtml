@model HomeIndexViewModel
@{
    ViewData["Title"] = "Home";
}

<section class="hero">
    <img src="~/images/hero.svg" alt="" class="hero-bg" />
    <div class="hero-content">
        <h1 class="display-5 fw-bold">Find and book sports facilities easily.</h1>
        <p class="lead">@Model.CouncilIntroduction</p>
        <div class="d-flex flex-wrap gap-2 mt-3">
            <a class="btn btn-light btn-lg" href="/Facility"><i class="bi bi-search me-1" aria-hidden="true"></i>Find Facilities</a>
            <a class="btn btn-outline-light btn-lg" href="/Facility/Search"><i class="bi bi-calendar-week me-1" aria-hidden="true"></i>Browse with Availability</a>
        </div>
    </div>
</section>

<section class="page-section">
    <h2 class="h3">Popular Sports</h2>
    <div class="row g-3">
        @foreach (var sport in Model.PopularSports)
        {
            var icon = ImageResolver.GetSportIconPath(sport.SportName);
            <div class="col-6 col-md-3">
                <a class="sport-tile" href="/Facility/Search?facilityType=@Uri.EscapeDataString(sport.SportName)">
                    @if (icon is not null)
                    {
                        <img src="@icon" alt="@sport.SportName" />
                    }
                    <span>@sport.SportName</span>
                </a>
            </div>
        }
    </div>
</section>

<section class="page-section">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h2 class="h3 mb-0">Featured Facilities</h2>
        <a href="/Facility" class="link-primary">View all facilities &rarr;</a>
    </div>
    <p class="text-muted">@Model.ActiveFacilityCount active facilities currently available to book.</p>
    @if (!Model.FeaturedFacilities.Any())
    {
        <div class="empty-state">
            <p>No facilities are currently available.</p>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var facility in Model.FeaturedFacilities)
            {
                @await Html.PartialAsync("~/Views/Facility/_FacilityCardPartial.cshtml", facility)
            }
        </div>
    }
</section>

<section class="page-section">
    <h2 class="h3 mb-4">How It Works</h2>
    <div class="row g-4 text-center">
        <div class="col-6 col-md-3">
            <div class="p-3">
                <div class="step-icon"><i class="bi bi-search" aria-hidden="true"></i></div>
                <h3 class="h6">Search</h3>
                <p class="small text-muted mb-0">Browse or search facilities by sport and location.</p>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="p-3">
                <div class="step-icon"><i class="bi bi-buildings" aria-hidden="true"></i></div>
                <h3 class="h6">Choose a facility</h3>
                <p class="small text-muted mb-0">View details, sports supported, and full facility information.</p>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="p-3">
                <div class="step-icon"><i class="bi bi-calendar2-check" aria-hidden="true"></i></div>
                <h3 class="h6">Select a time</h3>
                <p class="small text-muted mb-0">Check real-time availability for the date and time you want.</p>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="p-3">
                <div class="step-icon"><i class="bi bi-patch-check" aria-hidden="true"></i></div>
                <h3 class="h6">Confirm</h3>
                <p class="small text-muted mb-0">Confirm your booking instantly — no waiting for approval.</p>
            </div>
        </div>
    </div>
</section>

<section class="page-section">
    <h2 class="h3 mb-4">Why Book With Us</h2>
    <div class="row g-3">
        <div class="col-6 col-md-3">
            <div class="p-3 h-100 border rounded-3 bg-white">
                <i class="bi bi-signpost-split text-primary fs-4" aria-hidden="true"></i>
                <h3 class="h6 mt-2">Easy booking</h3>
                <p class="small text-muted mb-0">A simple, guided flow from search to confirmation.</p>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="p-3 h-100 border rounded-3 bg-white">
                <i class="bi bi-clock-history text-primary fs-4" aria-hidden="true"></i>
                <h3 class="h6 mt-2">Real-time availability</h3>
                <p class="small text-muted mb-0">See exactly which time slots are free before you book.</p>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="p-3 h-100 border rounded-3 bg-white">
                <i class="bi bi-trophy text-primary fs-4" aria-hidden="true"></i>
                <h3 class="h6 mt-2">Multiple sports</h3>
                <p class="small text-muted mb-0">@Model.PopularSports.Count sports across our facility network.</p>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="p-3 h-100 border rounded-3 bg-white">
                <i class="bi bi-shield-lock text-primary fs-4" aria-hidden="true"></i>
                <h3 class="h6 mt-2">Secure member accounts</h3>
                <p class="small text-muted mb-0">Your bookings and profile are private to you.</p>
            </div>
        </div>
    </div>
</section>

@if (User.Identity?.IsAuthenticated != true)
{
    <section class="page-section">
        <div class="p-4 rounded-3 bg-white border text-center">
            <h2 class="h5"><i class="bi bi-person-plus text-primary me-1" aria-hidden="true"></i>Become a Member</h2>
            <p class="text-muted mb-3">Register to search facilities by date and time, and make bookings.</p>
            <a href="/Account/Register" class="btn btn-primary">Register</a>
        </div>
    </section>
}

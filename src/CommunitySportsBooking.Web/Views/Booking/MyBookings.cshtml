@model MyBookingsViewModel
@{
    ViewData["Title"] = "My Bookings";
}

<h1>My Bookings</h1>

<h2 class="h4 mt-4">Upcoming</h2>
@if (!Model.UpcomingBookings.Any())
{
    <p>You have no upcoming bookings.</p>
}
else
{
    <table class="table">
        <thead><tr><th>Facility</th><th>Type</th><th>Date</th><th>Time</th></tr></thead>
        <tbody>
            @foreach (var b in Model.UpcomingBookings)
            {
                <tr>
                    <td>@b.FacilityName</td>
                    <td>@b.FacilityType</td>
                    <td>@b.BookingDate.ToString("yyyy-MM-dd")</td>
                    <td>@b.StartTime.ToString("HH:mm")–@b.EndTime.ToString("HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>
}

<h2 class="h4 mt-4">Completed</h2>
@if (!Model.CompletedBookings.Any())
{
    <p>You have no completed bookings yet.</p>
}
else
{
    <table class="table">
        <thead><tr><th>Facility</th><th>Type</th><th>Date</th><th>Time</th><th>Review</th></tr></thead>
        <tbody>
            @foreach (var b in Model.CompletedBookings)
            {
                <tr>
                    <td>@b.FacilityName</td>
                    <td>@b.FacilityType</td>
                    <td>@b.BookingDate.ToString("yyyy-MM-dd")</td>
                    <td>@b.StartTime.ToString("HH:mm")–@b.EndTime.ToString("HH:mm")</td>
                    <td>
                        @if (b.HasReview)
                        {
                            <span class="text-muted">Reviewed</span>
                        }
                        else
                        {
                            <a href="/Review/Create?bookingId=@b.BookingId">Leave a review</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@model FacilityDetailViewModel
@{
    ViewData["Title"] = Model.FacilityName;
}

<h1>@Model.FacilityName</h1>
<h5 class="text-muted">@Model.FacilityType</h5>

<dl class="row mt-3">
    <dt class="col-sm-3">Address</dt>
    <dd class="col-sm-9">@Model.AddressLine, @Model.City</dd>

    <dt class="col-sm-3">Location</dt>
    <dd class="col-sm-9">@Model.Location</dd>

    @if (Model.Capacity.HasValue)
    {
        <dt class="col-sm-3">Capacity</dt>
        <dd class="col-sm-9">@Model.Capacity</dd>
    }

    @if (!string.IsNullOrEmpty(Model.Description))
    {
        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@Model.Description</dd>
    }

    <dt class="col-sm-3">Sports Supported</dt>
    <dd class="col-sm-9">
        @if (Model.SupportedSports.Any())
        {
            @string.Join(", ", Model.SupportedSports)
        }
        else
        {
            <text>None listed</text>
        }
    </dd>
</dl>

<a href="/Facility" class="btn btn-secondary">Back to Facilities</a>
@if (User.Identity?.IsAuthenticated == true)
{
    <a href="/Booking/Create?facilityId=@Model.FacilityId" class="btn btn-primary">Book This Facility</a>
}

@model List<FacilitySummaryViewModel>
@{
    ViewData["Title"] = "Facilities";
}

<div class="page-section">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <h1 class="h3 mb-0">Facilities</h1>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a class="btn btn-primary" href="/Facility/Search">Search with availability</a>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <p class="mb-0">No facilities are currently available.</p>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var facility in Model)
            {
                @await Html.PartialAsync("_FacilityCardPartial", facility)
            }
        </div>
    }
</div>
